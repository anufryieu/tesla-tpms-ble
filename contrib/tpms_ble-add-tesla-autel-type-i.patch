+    def _process_tpms_i(self, address: str, local_name: str, data: bytes) -> None:
+        """Parser for Tesla-protocol BLE TPMS sensors (Type I).
+
+        Covers the Tesla OEM sensor and every aftermarket sensor that emulates
+        it, notably the Autel MX-Sensor BLE: a sensor sold pre-programmed for a
+        Tesla must speak this protocol, because the car's TPMS ECU understands
+        only one. Bluetooth SIG company identifier 0x022B (555) is assigned to
+        Tesla, Inc.
+
+        Payload layout after the company ID has been stripped:
+            0     unknown
+            1     unknown
+            2     status; < 0x05 means asleep and the measurement bytes are
+                  stale. A sleeping sensor usually stops here (e.g. 01 fe 03).
+            3-4   pressure, uint16 LE, absolute kPa
+            5     temperature, uint8, degC + 50
+            6-7   battery, uint16 LE, millivolts
+        """
+        _LOGGER.debug("Parsing TPMS TypeI (Tesla/Autel) data: %s", data.hex())
+
+        msg_length = len(data)
+        if msg_length < 3:
+            _LOGGER.debug(
+                "Found %s bytes from sensor: %s (expected >= 3)", msg_length, address
+            )
+            return
+
+        status = data[2]
+        if status < 0x05 and msg_length < 8:
+            # Asleep, like a fitted Autel sensor sending just 01 fe 03: nothing
+            # to publish, but it is still a sensor worth showing.
+            self._update_sensors(address, None, None, None, None, None)
+            return
+        if msg_length < 8:
+            _LOGGER.debug(
+                "Found %s bytes from sensor: %s (expected >= 8)", msg_length, address
+            )
+            return
+
+        battery_mv = int.from_bytes(data[6:8], "little")
+
+        # Tesla vehicles advertise under the same company ID; reject anything
+        # whose battery field is not a plausible cell voltage.
+        if not 1500 <= battery_mv <= 4300:
+            _LOGGER.debug(
+                "Tesla company ID from %s but not a TPMS frame: %s", address, data.hex()
+            )
+            return
+
+        battery_voltage = round(battery_mv / 1000.0, 3)
+        battery_pct = battery_percentage(battery_voltage)
+
+        if status < 0x05:
+            # Asleep: the pressure and temperature bytes are not refreshed, so
+            # publish only the battery rather than a stale reading.
+            self._update_sensors(
+                address, None, battery_pct, None, None, battery_voltage
+            )
+            return
+
+        raw_pressure = int.from_bytes(data[3:5], "little")
+        # The raw value is absolute kPa; subtract one atmosphere for gauge.
+        pressure_bar = round((raw_pressure - 100) / 100.0, 3)
+        if -0.2 < pressure_bar < 0.0:
+            pressure_bar = 0.0
+
+        temperature_celcius = data[5] - 50
+
+        self._update_sensors(
+            address,
+            pressure_bar,
+            battery_pct,
+            temperature_celcius,
+            None,
+            battery_voltage,
+        )
+
     def _update_sensors(
         self,
         address: str,
diff --git a/tests/test_parser.py b/tests/test_parser.py
index fd351aa..a366047 100644
--- a/tests/test_parser.py
+++ b/tests/test_parser.py
@@ -365,3 +365,62 @@ def test_stale_manufacturer_data_resolution() -> None:
     v3 = get_sensor_values(parser, info3)
     # Must pick the updated 0x2000 reading (0.0 bar), NOT the stale 0x2001 at the end!
     assert v3[TPMSSensor.PRESSURE] == 0.0
+
+
+def test_type_i_tesla_autel() -> None:
+    """Type I (Tesla / Autel): Company ID 555 (0x022B).
+
+    Raw pressure is absolute kPa, temperature is degC + 50, battery is
+    millivolts. A sleeping sensor sends only the three bytes up to status and
+    its measurement bytes are stale, so nothing is published from one.
+    """
+    parser = TPMSBluetoothDeviceData()
+
+    # 390 kPa absolute -> 2.90 bar gauge, 72 -> 22 degC, 3050 mV.
+    payload = (
+        bytes([0x01, 0x02, 0x0A])
+        + (390).to_bytes(2, "little")
+        + bytes([72])
+        + (3050).to_bytes(2, "little")
+    )
+    info = BluetoothServiceInfo(
+        name="tsTPMS",
+        address="BC:6A:29:00:10:F1",
+        rssi=-71,
+        manufacturer_data={555: payload},
+        service_data={},
+        service_uuids=[],
+        source="local",
+    )
+    values = get_sensor_values(parser, info)
+    assert values[TPMSSensor.PRESSURE] == 2.9
+    assert values[TPMSSensor.TEMPERATURE] == 22
+    assert values[TPMSSensor.VOLTAGE] == 3.05
+
+    # Real sleep frame from a fitted Autel MX-Sensor BLE: no measurement at all.
+    sleep_info = BluetoothServiceInfo(
+        name="tsTPMS",
+        address="BC:6A:29:00:11:04",
+        rssi=-71,
+        manufacturer_data={555: bytes.fromhex("01fe03")},
+        service_data={},
+        service_uuids=[],
+        source="local",
+    )
+    sleep_values = get_sensor_values(TPMSBluetoothDeviceData(), sleep_info)
+    assert TPMSSensor.PRESSURE not in sleep_values
+    assert TPMSSensor.TEMPERATURE not in sleep_values
+
+    # A Tesla vehicle advertises under the same company ID. Its payload has no
+    # plausible cell voltage at offset 6..7, and must not become a tyre.
+    vehicle = bytes([0x01, 0x02, 0x0A, 0x86, 0x01, 0x48]) + (51000).to_bytes(2, "little")
+    vehicle_info = BluetoothServiceInfo(
+        name="Tesla Model 3",
+        address="AA:BB:CC:DD:EE:F0",
+        rssi=-60,
+        manufacturer_data={555: vehicle},
+        service_data={},
+        service_uuids=[],
+        source="local",
+    )
+    assert TPMSBluetoothDeviceData().supported(vehicle_info) is False
